# 公网 Spring Boot 服务配置。复制到云平台的 Environment Variables，切勿提交真实值。
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_POSTGRES_HOST:5432/YOUR_DATABASE?sslmode=require
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USER
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

# 使用密码管理器生成至少 32 字节的随机值。
EVIDENCE_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_LONGER_THAN_32_BYTES
EVIDENCE_CORS_ALLOWED_ORIGIN=https://YOUR-NETLIFY-SITE.netlify.app

# 首次答辩数据初始化可临时设为 true；完成首次登录后改为 false 并重新部署。
EVIDENCE_BOOTSTRAP_ENABLED=false
EVIDENCE_BOOTSTRAP_USERNAME=demo-super-admin
EVIDENCE_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
EVIDENCE_BOOTSTRAP_ORGANIZATION=DEMO_MUSEUM

# 当前项目为明确标识的 Demo 链/IPFS 模式。
EVIDENCE_MODE=DEMO
EVIDENCE_CHAIN_MODE=DEMO
EVIDENCE_IPFS_MODE=DEMO
