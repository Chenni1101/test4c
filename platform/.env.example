# 本地开发时使用本机后端；Netlify 环境变量中必须替换为公网 HTTPS 后端地址。
VITE_API_BASE_URL=http://localhost:8080/api

# 现场答辩推荐保持 true：登录/注册入口被隐藏，资产发行、授权与溯源使用
# 浏览器本地的确定性演示适配器，不依赖网络或后端。页面会明确显示“现场离线演示模式”。
# 需要联调真实后端 API 时改为 false。
VITE_OFFLINE_DEMO=true

# 可选：图像识别代理接口。接口应接收 multipart/form-data 的 image、filename 并返回
# { artifactType, era, description, keywords }。请不要将第三方 AI 密钥写入前端环境变量；
# 密钥应由后端/网关托管。未配置、超时或失败时会使用明确标识的本地 Demo fallback。
# VITE_AI_VISION_API_URL=https://your-api-gateway.example/api/ai/vision

# 可选：答辩时可使用已审核的轻量 GLB 模型（建议单个不超过 5 MB）。
# 未配置时使用 modelviewer.dev 的公开演示模型；网络失败将降级为静态图片。
# VITE_3D_MODEL_A=/models/exhibit-a.glb
# VITE_3D_MODEL_B=/models/exhibit-b.glb
